{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Display Name Styles",
  "theme": "maple",
  "colors": {
    "primary": "#0000EE",
    "light": "#6699FF",
    "dark": "#000080"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "pages": ["index", "introduction", "gotchas"]
